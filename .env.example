# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# Never commit the real .env file — it is git-ignored.
# ---------------------------------------------------------------------------

# Port the API server listens on
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (use * to allow all in dev)
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Task 3 will add a real database here, e.g.:
# MONGODB_URI=mongodb://localhost:27017/devboard
# ---------------------------------------------------------------------------
